# Copy to keystore.properties and fill in. Create a key with:
#   keytool -genkeypair -v -keystore keystore/lumo.jks -alias lumo -keyalg RSA -keysize 2048 -validity 10000
# Updates only install over an existing app when they are signed with the SAME key.
storeFile=keystore/lumo.jks
storePassword=change-me
keyAlias=lumo
keyPassword=change-me
